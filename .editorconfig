# .editorconfig - the same text format in every editor (VS Code, Codespaces, Notepad++, ...)
# Explained in docs/06-files-explained.md
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{bat,ps1}]
end_of_line = crlf

[*.md]
# Markdown uses two spaces at the end of a line for a line break
trim_trailing_whitespace = false

[*.py]
indent_size = 4
