# .gitattributes - tells Git how to store line endings.
# Linux files (scripts, YAML, docs) must use LF line endings, even when the
# project is downloaded on Windows. Windows files use CRLF.
*            text=auto eol=lf
*.bat        text eol=crlf
*.ps1        text eol=crlf
# Pictures are binary: Git must never change a single byte in them.
*.png        binary
*.jpg        binary
*.ico        binary
