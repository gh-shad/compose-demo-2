    family-names: "H"
version: "2.1"
date-released: "2026-11-15"
license: MIT
repository-code: "https://github.com/gh-shad/compose-demo-2"
keywords:
  - docker
  - docker-compose
  - git
  - github
  - education
  - tutorial
